# Files excluded from the packaged .vsix. The published extension ships only
# the bundled dist/, the webview media, the icon, and the docs — never the
# TypeScript sources, tests, or build tooling.
.vscode/**
.github/**
.devcontainer/**
src/**
test/**
out/**
node_modules/**
# …except the prebuilt Windows ConPTY backend, which the chat needs to run the
# agy TUI on native Windows (#1, #2). Node-API binaries, so no rebuild per VS
# Code version. Listed file-by-file because vsce's negations always beat a later
# ignore rule — a blanket `!…/**` would drag in 10 MB of .pdb debug symbols.
!node_modules/@lydell/node-pty-win32-*/package.json
!node_modules/@lydell/node-pty-win32-*/LICENSE
!node_modules/@lydell/node-pty-win32-*/lib/**
!node_modules/@lydell/node-pty-win32-*/prebuilds/**/*.node
!node_modules/@lydell/node-pty-win32-*/prebuilds/*/conpty/**
docs/**
**/*.ts
**/*.map
esbuild.js
tsconfig*.json
.mocharc.json
.gitignore
.editorconfig
**/.DS_Store
.vscode/**
cache/**
.antigravitycli/**
.claude/**
.agents/**
